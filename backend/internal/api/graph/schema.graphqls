scalar Time

directive @goField(forceResolver: Boolean, name: String, omittable: Boolean) on INPUT_FIELD_DEFINITION | FIELD_DEFINITION

enum ContentType {
  NOVEL
  MANGA
  ANIME
}

type Repository {
  id: ID!
  indexUrl: String!
  name: String
  contentType: ContentType!
  addedAt: Time!
  lastSyncedAt: Time
}

type Extension {
  id: ID!
  repositoryId: ID!
  packageName: String!
  name: String!
  version: String!
  contentType: ContentType!
  lang: String!
  iconUrl: String
  apkUrl: String
  jarUrl: String
  jarPath: String
  installed: Boolean!
  enabled: Boolean!
  discoveredAt: Time!
  installedAt: Time
  installedVersion: String
  needsUpdate: Boolean
  isNsfw: Boolean!
  displayName: String!
  supportsLatest: Boolean!
}

type ExtensionPage {
  items: [Extension!]!
  total: Int!
  languages: [String!]!
}

enum SolverMode { DISABLED EXTERNAL MANAGED }
enum SolverState { NOT_INSTALLED DOWNLOADING INSTALLED RUNNING ERROR }

enum SettingKind { BOOTSTRAP RUNTIME }
enum SettingType { BOOL INT STRING }
enum SettingScope { LIVE SANDBOX_RESTART FULL_RESTART }
enum SettingSource { FILE DB DEFAULT }

type ServerSetting {
  key: String!
  value: String!
  default: String!
  type: SettingType!
  kind: SettingKind!
  scope: SettingScope!
  source: SettingSource!
  editable: Boolean!
  description: String!
}

type UpdateSettingResult {
  setting: ServerSetting!
  restartRequired: Boolean!
}

enum FilterField { GENRE TAG TITLE DESCRIPTION }
enum ContentBlockLevel { MODERATE STRICT }

type ContentFilterRule {
  id: ID!
  category: String!
  field: FilterField!
  keyword: String!
  minWeight: Int!
  blockLevel: ContentBlockLevel!
  isDefault: Boolean!
}

type TagFacet {
  id: ID!
  name: String!
  count: Int!
  maxWeight: Int!
}

type CloudflareSolver {
  mode: SolverMode!
  state: SolverState!
  downloadProgress: Float
  version: String
  url: String
  reachable: Boolean!
  error: String
  supportedOnPlatform: Boolean!
}

type Media {
  id: ID!
  extensionId: ID
  extensionName: String!

  sourceName: String!
  externalId: String!
  contentType: ContentType!
  title: String!
  thumbnailUrl: String
  description: String
  status: String
  author: String
  artist: String
  detailsFetchedAt: Time
  extensionRemovedAt: Time
  addedAt: Time
  lastViewedAt: Time
  inLibrary: Boolean!
  chapters: [Chapter!]! @goField(forceResolver: true)
  chapterCount: Int! @goField(forceResolver: true)
  unreadCount: Int! @goField(forceResolver: true)
  downloadedCount: Int! @goField(forceResolver: true)
  nextUnreadChapter: Chapter @goField(forceResolver: true)
  latestChapter: Chapter @goField(forceResolver: true)
  readingProgress: [ReadingProgress!]! @goField(forceResolver: true)
  tags: [String!]! @goField(forceResolver: true)
  genres: [String!]! @goField(forceResolver: true)
  folders: [Folder!]! @goField(forceResolver: true)
  trackLinks: [TrackLink!]! @goField(forceResolver: true)
  metadata: MetadataMatch @goField(forceResolver: true)
  source: Extension @goField(forceResolver: true)
}

type MetadataMatch {
  mediaId: ID!
  provider: String!
  providerId: String!
  url: String!
  coverUrl: String
  malId: Int @goField(forceResolver: true)
  malUrl: String @goField(forceResolver: true)
  confidence: Float!
  locked: Boolean!
  matchedAt: Time!
}

type MetadataCandidate {
  provider: String!
  providerId: String!
  title: String!
  url: String!
  coverUrl: String
  description: String
  status: String
  genres: [String!]!
  startYear: Int
}

type Tracker {
  key: String!
  name: String!
  configured: Boolean!
  isLoggedIn: Boolean!
  authUrl: String
  username: String
  scoreOptions: [String!]!

  statusOptions: [TrackStatus!]!

  iconUrl: String
}

type TrackStatus {
  value: Int!

  name: String!

  animeName: String!
}

type TrackSearchResult {
  remoteId: String!
  title: String!
  url: String!
  coverUrl: String
  summary: String

  totalChapters: Int
  publishingStatus: String

  mediaType: String
}

type TrackLink {
  id: ID!
  mediaId: ID!
  trackerKey: String!
  remoteId: String!
  title: String!
  url: String!
  status: Int!
  statusName: String!
  lastChapterRead: Float!
  totalChapters: Int!
  score: Float!
  startedAt: Time
  finishedAt: Time
  private: Boolean!
  lastSyncedAt: Time
}

type Chapter {
  id: ID!
  mediaId: ID!
  externalId: String!
  title: String
  number: Float
  sourceOrder: Int

  scanlator: String
  uploadedAt: Time
  readingProgress: ReadingProgress @goField(forceResolver: true)
  completed: Boolean! @goField(forceResolver: true)
  downloaded: Boolean! @goField(forceResolver: true)
  download: Download @goField(forceResolver: true)
  pages: [String!] @goField(forceResolver: true)
  pageCount: Int @goField(forceResolver: true)
  videoUrl: String @goField(forceResolver: true)

  videoStream: VideoStream @goField(forceResolver: true)
}

type VideoStream {

  url: String!
  sources: [VideoSource!]!
  subtitles: [SubtitleTrack!]!
  audioTracks: [AudioTrack!]!
  skipMarkers: [SkipMarker!]!
}

type VideoSource {
  label: String!
  resolution: Int
  preferred: Boolean!

  kind: String!

  server: String!

  url: String!
}

type SubtitleTrack {
  lang: String!

  url: String!
}

type AudioTrack {
  lang: String!
  url: String!
}

type SkipMarker {
  type: String!
  name: String!
  startMs: Int!
  endMs: Int!
}

enum DownloadStatus {
  QUEUED
  DOWNLOADING
  DONE
  FAILED
}

type Download {
  id: ID!
  mediaId: ID!
  chapterId: ID!
  chapter: Chapter! @goField(forceResolver: true)
  status: DownloadStatus!
  progress: Float!
  downloadedBytes: Float
  bytesPerSec: Float
  finalSizeBytes: Float
  error: String
  createdAt: Time!
  completedAt: Time
}

type ReadingProgress {
  id: ID!
  mediaId: ID!
  chapterId: ID!
  progress: Float!
  completed: Boolean!
  positionSeconds: Float
  durationSeconds: Float
  updatedAt: Time!
}

type DownloaderStatus {
  isRunning: Boolean!
  queuedCount: Int!
  downloadingCount: Int!
  failedCount: Int!
}

type RecentChapter {
  chapter: Chapter!
  media: Media!
}

type SearchResponse {
  results: [Media!]!
  hasNextPage: Boolean!
}

type MediaPage {
  items: [Media!]!
  total: Int!
  hasMore: Boolean!
}

type StorageInfo {
  usedBytes: Float!
  totalBytes: Float!
  freeBytes: Float!
}

type AboutServer {
  name: String!
  version: String!
  buildTime: String!
}

type Folder {
  id: ID!
  name: String!
  kind: String!
  systemKey: String
  parentFolderId: ID
  sortOrder: Int!
  includeInUpdate: Boolean!
  includeInDownload: Boolean!
}

enum LibrarySort {
  TITLE
  ADDED_AT
  LAST_READ_AT
  LATEST_CHAPTER_AT
  UNREAD_COUNT
}

input LibrarySortInput {
  by: LibrarySort! = ADDED_AT
  ascending: Boolean! = false
}

input LibraryFilter {
  contentType: ContentType

  inLibrary: Boolean = true
  unreadOnly: Boolean
  downloadedOnly: Boolean
  tagIds: [ID!]
  genreIds: [ID!]
  folderId: ID
  query: String
}

type Query {
  about: AboutServer!
  folders: [Folder!]!
  folder(id: ID!): Folder
  mediaInFolder(folderId: ID!): [Media!]!
  repositories: [Repository!]!
  availableExtensions(repositoryId: ID!): [Extension!]!
  installedExtensions: [Extension!]!
  cloudflareSolver: CloudflareSolver!
  serverSettings: [ServerSetting!]!
  contentFilterRules: [ContentFilterRule!]!
  libraryTags(minCount: Int = 1): [TagFacet!]!
  libraryGenres(minCount: Int = 1): [TagFacet!]!
  extensions(
    repositoryId: ID
    query: String
    contentType: ContentType
    lang: String
    installed: Boolean
    limit: Int = 60
    offset: Int = 0
  ): ExtensionPage!

  library(filter: LibraryFilter, sort: LibrarySortInput, limit: Int = 100, offset: Int = 0): MediaPage!
  media(id: ID!): Media

  chapter(id: ID!): Chapter

  resolveMedia(extensionId: ID!, externalId: String!, syncChapters: Boolean = true): Media!

  readingProgress(mediaId: ID!): [ReadingProgress!]!
  search(extensionId: ID!, query: String!, page: Int, filters: [FilterInput!]): SearchResponse!
  filterOptions(extensionId: ID!): [FilterNode!]!
  popularManga(extensionId: ID!, page: Int): SearchResponse!
  latestUpdates(extensionId: ID!, page: Int): SearchResponse!
  downloadStatus(mediaId: ID!, chapterId: ID!): Download
  downloadQueue: [Download!]!
  downloaderStatus: DownloaderStatus!
  recentChapters(since: Time, limit: Int): [RecentChapter!]!

  chapterUpdates(since: Time, limit: Int): [RecentChapter!]!

  libraryUpdateStatus: LibraryUpdateStatus!
  storageInfo: StorageInfo!

  trackers: [Tracker!]!

  trackSearch(trackerKey: String!, query: String!, contentType: ContentType): [TrackSearchResult!]!

  searchMetadata(query: String!, contentType: ContentType!, provider: String): [MetadataCandidate!]!

  skipTimestamps(chapterId: ID!, episodeLengthMs: Int): [SkipMarker!]!
}

type LibraryUpdateStatus {
  running: Boolean!
  total: Int!
  done: Int!
  currentTitle: String
  newChapterCount: Int!
  failedTitles: [String!]!
  startedAt: Time
  finishedAt: Time
}

type Mutation {
  createFolder(name: String!, parentFolderId: ID): Folder!
  renameFolder(folderId: ID!, name: String!): Folder!
  deleteFolder(folderId: ID!): Boolean!
  addMediaToFolder(mediaId: ID!, folderId: ID!): Boolean!
  removeMediaFromFolder(mediaId: ID!, folderId: ID!): Boolean!

  markChaptersRead(mediaId: ID!, chapterIds: [ID!]!, read: Boolean!): [ReadingProgress!]!
  dequeueDownload(mediaId: ID!, chapterId: ID!): Boolean!

  addRepository(indexUrl: String!, name: String): Repository!
  renameRepository(repositoryId: ID!, name: String!): Repository!
  deleteRepository(repositoryId: ID!): Boolean!
  syncRepository(repositoryId: ID!): Repository!
  syncRepositories: [Repository!]!

  updateServerSetting(key: String!, value: String!): UpdateSettingResult!

  addContentFilterRule(category: String!, field: FilterField!, keyword: String!, minWeight: Int = 0, blockLevel: ContentBlockLevel!): ContentFilterRule!
  removeContentFilterRule(id: ID!): Boolean!
  resetContentFilterRules: Boolean!
  recomputeContentFilter: Boolean!
  installCloudflareSolver: CloudflareSolver!
  uninstallCloudflareSolver: Boolean!
  installExtension(packageName: String!): Extension!
  installExternalExtension(url: String!): Extension!
  uninstallExtension(packageName: String!): Extension!
  updateExtension(packageName: String!): Extension!

  setInLibrary(mediaId: ID!, inLibrary: Boolean!): Media!
  migrateMedia(fromMediaId: ID!, toExtensionId: ID!, toExternalId: String!): Media!
  syncChapters(mediaId: ID!): [Chapter!]!
  updateReadingProgress(mediaId: ID!, chapterId: ID!, progress: Float!, completed: Boolean, positionSeconds: Float, durationSeconds: Float): ReadingProgress!
  markChapterRead(mediaId: ID!, chapterId: ID!): ReadingProgress!
  enqueueDownload(mediaId: ID!, chapterIds: [ID!]!): [Download!]!
  retryDownload(mediaId: ID!, chapterId: ID!): Download!
  deleteDownload(mediaId: ID!, chapterIds: [ID!]!): Boolean!
  reorderDownload(mediaId: ID!, chapterId: ID!, position: Int!): Boolean!
  clearDownloads(status: [DownloadStatus!]): Boolean!
  startDownloader: Boolean!
  stopDownloader: Boolean!
  refreshMetadata(mediaId: ID!, syncChapters: Boolean = true): Media!
  refreshFolder(folderId: ID!): [Media!]!
  reorderFolder(folderId: ID!, sortOrder: Int!): Folder!
  updateFolderFlags(folderId: ID!, includeInUpdate: Boolean, includeInDownload: Boolean): Folder!
  clearImageCache: Boolean!

  startLibraryUpdate(folderId: ID): Boolean!

  setMediaCover(mediaId: ID!, url: String): Media!

  rescanLocalMedia: [Media!]!

  trackerLogin(trackerKey: String!, token: String!): Tracker!
  trackerLogout(trackerKey: String!): Boolean!

  bindTrack(mediaId: ID!, trackerKey: String!, remoteId: String!): TrackLink!

  updateTrack(linkId: ID!, status: Int, score: Float, lastChapterRead: Float): TrackLink!
  unbindTrack(linkId: ID!): Boolean!

  resyncTrack(linkId: ID!): TrackLink!

  pullTracker(mediaId: ID!): [TrackLink!]!

  applyMetadataMatch(mediaId: ID!, providerId: String!, provider: String): Media!

  unlinkMetadata(mediaId: ID!): Boolean!

  refreshMetadataMatch(mediaId: ID!): Media!
}

union FilterNode = HeaderFilter | SeparatorFilter | SelectFilter | TextFilter | CheckBoxFilter | TriStateFilter | GroupFilter | SortFilter

type HeaderFilter {
  name: String!
}

type SeparatorFilter {
  name: String!
}

type SelectFilter {
  name: String!
  values: [String!]!
  state: Int!
}

type TextFilter {
  name: String!
  state: String!
}

type CheckBoxFilter {
  name: String!
  state: Boolean!
}

type TriStateFilter {
  name: String!
  state: Int!
}

type GroupFilter {
  name: String!
  children: [FilterNode!]!
}

type SortFilter {
  name: String!
  values: [String!]!
  hasState: Boolean!
  index: Int
  ascending: Boolean
}

input FilterInput {
  name: String!
  select: SelectFilterInput
  text: TextFilterInput
  checkbox: CheckBoxFilterInput
  tristate: TriStateFilterInput
  group: GroupFilterInput
  sort: SortFilterInput
}

input SelectFilterInput {
  state: Int!
}

input TextFilterInput {
  state: String!
}

input CheckBoxFilterInput {
  state: Boolean!
}

input TriStateFilterInput {
  state: Int!
}

input GroupFilterInput {
  children: [FilterInput!]!
}

input SortFilterInput {
  hasState: Boolean!
  index: Int
  ascending: Boolean
}
